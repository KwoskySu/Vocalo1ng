<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp"
    android:paddingTop="12dp" android:paddingBottom="8dp" android:background="#F5F8F7">
    <LinearLayout android:layout_width="match_parent" android:layout_height="60dp" android:gravity="center_vertical">
        <ImageView android:id="@+id/track_cover" android:layout_width="56dp" android:layout_height="56dp" android:scaleType="centerCrop" android:contentDescription="歌曲封面"/>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:orientation="vertical">
            <TextView android:id="@+id/track_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#192B29" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"/>
            <TextView android:id="@+id/track_artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textColor="#566B67" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"/>
        </LinearLayout>
    </LinearLayout>
    <ProgressBar android:id="@+id/track_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="12dp" android:max="1000" android:progressTint="#38766A" android:progressBackgroundTint="#DCE5E2"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="20dp" android:gravity="center_vertical">
        <TextView android:id="@+id/track_position" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="#566B67" android:textSize="10sp" android:maxLines="1"/>
        <TextView android:id="@+id/track_duration" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#566B67" android:textSize="10sp" android:maxLines="1"/>
    </LinearLayout>
</LinearLayout>
