<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="64dp"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:paddingStart="12dp" android:paddingEnd="12dp" android:background="#F5F8F7">
    <ImageView android:id="@+id/track_cover" android:layout_width="44dp" android:layout_height="44dp" android:scaleType="centerCrop" android:contentDescription="歌曲封面"/>
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:orientation="vertical">
        <TextView android:id="@+id/track_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#192B29" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/track_artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#566B67" android:textSize="10sp" android:maxLines="1" android:ellipsize="end"/>
        <ProgressBar android:id="@+id/track_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="3dp" android:layout_marginTop="3dp" android:max="1000" android:progressTint="#38766A" android:progressBackgroundTint="#DCE5E2"/>
        <TextView android:id="@+id/track_position" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#566B67" android:textSize="9sp" android:maxLines="1"/>
    </LinearLayout>
</LinearLayout>
